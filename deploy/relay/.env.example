# ── New API relay configuration ──
# Copy this file to `.env` (in the same directory) and adjust the values,
# then run `docker compose up -d`.

# REQUIRED: a long, random string used to sign login sessions.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-please

# Timezone for logs / scheduled tasks.
TZ=Asia/Shanghai

# Runtime toggles (safe defaults shown).
MEMORY_CACHE_ENABLED=true
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true

# Optional human-readable node name shown in the panel.
NODE_NAME=emperor-relay

# (Optional) External database / cache. Leave EMPTY to use the default
# SQLite database stored in the mounted ./data volume.
# SQL_DSN=
# REDIS_CONN_STRING=
