# ──────────────────────────────────────────────────────────────────────────
# emperor-core · 免费模型（OpenAI 兼容）接入配置
#
# 复制为 .env 后填入真实值即可让系统从 mock 模式切换到真实模型。
# 任意 OpenAI 兼容端点都可用：ChatOpens、DeepSeek、本地 Ollama 等。
#
# 适配 ChatOpens 免费模型：
#   1. 打开 ChatOpens → 设置 → 开发者模式 / API
#   2. 复制  Base URL（形如 https://xxx/v1）和 API Key
#   3. 填入下方 OPENAI_BASE_URL / OPENAI_API_KEY
#   4. OPENAI_MODEL 填 ChatOpens 提供的模型名（如 gpt-4o）
#   5. 运行：python scripts/test_llm_connectivity.py 验证连通性
# ──────────────────────────────────────────────────────────────────────────

# 端点协议（OpenAI 兼容代理保持 openai 即可）
OPENAI_PROVIDER=openai

# ChatOpens 开发者模式给出的模型名（gpt-4o / gpt-4o-mini / claude-3-5-sonnet …）
OPENAI_MODEL=gpt-4o

# ChatOpens 开发者模式的 API Key（无密钥的代理可填任意非空串，如 sk-noauth）
OPENAI_API_KEY=your-chatopens-api-key

# ChatOpens 开发者模式的 Base URL（必须含 /v1 这类路径前缀）
OPENAI_BASE_URL=https://your-chatopens-base-url/v1

# 可选
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# ── 按环境解析 Base URL（可选，进阶用法）──────────────────────────────
# 设置 OPENAI_ENV 后，base_url 由对应环境的专用变量决定：
#   development -> OPENAI_DEV_URL  (默认 https://api.openai.com/v1/)
#   testing     -> OPENAI_TEST_URL (默认 https://test-openai.your-company.com/v1/)
#   production  -> OPENAI_PROD_URL (默认 https://openai.your-company.com/v1/)
# 注意：OPENAI_BASE_URL 优先级最高，会覆盖下方任何环境变量。
OPENAI_ENV=development
OPENAI_DEV_URL=https://api.openai.com/v1/
OPENAI_TEST_URL=https://test-openai.your-company.com/v1/
OPENAI_PROD_URL=https://openai.your-company.com/v1/

# ── 同时接入各种免费模型（多后端故障转移）──────────────────────────────
# 主端点之外的「备用后端」列表。任一后端调用失败（限流/401/网络）会自动切换到下一个，
# 永不因单个免费端点抖动而中断 JARVIS 的自学习闭环。
#
# 方式 A：直接列 URL（可平行给 MODELS / KEYS，逗号分隔、按顺序对应）
# OPENAI_FALLBACK_BASE_URLS=https://api.groq.com/openai/v1,https://openrouter.ai/api/v1
# OPENAI_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-4o-mini
# OPENAI_FALLBACK_KEYS=sk-groq-xxx,sk-or-xxx
#
# 方式 B：直接用注册表里内置的免费端点名（各自从对应 key 环境变量取 key）
#   可选名：deepseek / groq / openrouter / together / mistral / ollama
#   例：同时挂 DeepSeek + 本地 Ollama（无需 key）
# OPENAI_FALLBACK_PROVIDERS=deepseek,ollama
# DEEPSEEK_API_KEY=sk-deepseek-xxx
#
# 自进化闭环（RealTaskExecutor）同样读取以上变量，自动故障转移到下一个免费模型。

