# emperor-core 部署环境变量示例
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
# docker compose 会自动读取同目录下的 .env

# ── 访问令牌（强烈建议设置，避免 8000 公网裸奔）──
# 生成：openssl rand -hex 24
# 留空 = 不鉴权（仅限内网 / 实验）
# 注意：该值同时作为「管理员初始密码」的回退（见下方 EMPEROR_ADMIN_PASS）
EMPEROR_API_TOKEN=

# ── 单用户强制登录：唯一管理员账号（注册已关闭）──
# 用户名默认 admin；初始密码默认 = 上面的 EMPEROR_API_TOKEN 值，
# 可显式设置自定义强密码（改完需 docker compose up -d --build 重建）。
# EMPEROR_ADMIN_USER=admin
# EMPEROR_ADMIN_PASS=

# ── 运行形态 ──
EMPEROR_MODE=server
EMPEROR_LLM_PROVIDER=mock

# ── 接真实大模型（按需取消注释，填入真实 Key；不设则自动 mock）──
# OPENAI_API_KEY=
# OPENAI_BASE_URL=        # 自定义 OpenAI 兼容端点（如自建/代理）
# OPENAI_MODEL=
# AGNES AI（OpenAI 兼容网关，国内可达，文本/图像/视频多模态；agnes-2.0-flash 免费档）
#   申请 Key：https://platform.agnes-ai.com → API 密钥；Base URL 官方为 https://apihub.agnes-ai.com/v1
#   文本模型 agnes-2.0-flash（稳定）/ agnes-2.5-flash（灰度）；图像 agnes-image-2.1-flash；视频 agnes-video-v2.0
#   注：emperor-core 主对话走文本模型；图像/视频为"生成类"模型，与系统的"上传图片理解"不是同一能力。
# OPENAI_API_KEY=sk-你的AgnesKey
# OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
# OPENAI_MODEL=agnes-2.0-flash
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=         # NVIDIA NIM 免费档 Key（build.nvidia.com 申请）
# NVIDIA_MODEL=           # 留空用默认 meta/llama-3.1-8b-instruct；可换其它 NIM 模型
# ANTHROPIC_API_KEY=
# ── 多后端故障转移：逗号分隔，如 nvidia,deepseek,openrouter ──
# OPENAI_FALLBACK_PROVIDERS=

# ── 多用户开放注册 ──
# 1 = 开放注册（默认），0 = 关闭（仅管理员账号）
EMPEROR_OPEN_REGISTRATION=1

# ── 数据卷根（文件上传落盘目录在其下的 uploads/）──
# EMPEROR_DATA_DIR=/app/data

# ── 文件上传 ──
# UPLOAD_MAX_MB=20

# ── 联网搜索（必应/搜狗爬虫优先 + DuckDuckGo 兜底，免费无 key）──
# 说明：百度 www.baidu.com/s 对无 cookie 请求返回「安全验证」反爬页，故未内置。
# SEARCH_PROVIDER=auto        # auto(默认，级联) | bing | sogou | duckduckgo
# SEARCH_ENGINES=bing,sogou,duckduckgo   # auto 模式下的引擎顺序
# SEARCH_MAX_RESULTS=5
# SEARCH_TIMEOUT=8
# SEARCH_BACKENDS=auto,html,lite          # DuckDuckGo 引擎的 backend 顺序
# SEARCH_BACKEND_COOLDOWN=30              # 失败引擎冷却秒数

# ── 图文识别（Groq LLaVA 主后端，复用 GROQ_API_KEY）──
# VISION_PROVIDER=groq
# VISION_MODEL=llava-v1.5-7b-4096-preview
# GROQ_API_KEY=            # GroqCloud 免费档 Key（vision 与文本 LLM 共用）
# ── 视觉备选后端（逗号分隔，如 Cloudflare；通用挂载，按需注入）──
# VISION_FALLBACK_BASE_URLS=
# VISION_FALLBACK_MODELS=
# VISION_FALLBACK_KEYS=

# ── 普通用户默认配额（JSON，空 = 不限额；本轮仅落库，不实现拦截规则）──
# USER_DEFAULT_QUOTA=
