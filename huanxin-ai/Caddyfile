# ============================================================
# 幻炘AI 反向代理 + 自动 SSL
# ------------------------------------------------------------
# Caddy 自动向 Let's Encrypt 申请并续期 huanxin.kdns.fr 证书
# （HTTP-01 挑战走 80 端口，需阿里云安全组放通 80/443）。
#
# 与本仓库 docker-compose.yml 的 caddy 服务配套使用；
# 同 compose 默认网络下，huanxin-ai 容器名即主机名，可直接反代。
#
# 若脱离 compose 单独运行，把 huanxin-ai:8000 改成宿主机可达地址，
# 例如 127.0.0.1:8000（服务直接跑在宿主机）或对应容器 IP。
# ============================================================

huanxin.kdns.fr {

    # 访问日志（排错用，可删）
    log {
        output stdout
    }

    # ── 反向代理到幻炘AI 服务（FastAPI，监听 8000）──────────
    reverse_proxy huanxin-ai:8000

    # 说明：
    # - /health、/dashboard、/court/*、/docs、/api/* 全部由后端提供，
    #   无需在 Caddy 侧额外配置路由，反代会原样转发。
    # - 若后端有长连接 / SSE 流式响应，Caddy 默认已支持 WebSocket 与
    #   分块传输，一般无需额外指令；如遇到超时，可加：
    #   reverse_proxy huanxin-ai:8000 {
    #       transport http {
    #           max_idle_conns_per_host 100
    #       }
    #   }
}
