# 幻炘AI 部署环境变量模板
# ------------------------------------------------------------
# 复制为同目录 .env 并填入真实值；docker-compose.yml 通过 ${VAR:-} 透传。
# 至少设置 HUANXIN_API_TOKEN（脚本 ecs_init.sh 会自动生成）。
# 不设任何大模型 Key 时，系统自动降级 mock 模式，仍可完整启动（离线自进化）。

# ── 访问鉴权（强烈建议设置！避免 8000 公网裸奔）──
HUANXIN_API_TOKEN=请改为随机值，例如 openssl rand -hex 24 的输出
HUANXIN_ADMIN_USER=admin
HUANXIN_ADMIN_PASS=初始管理员密码，可复用 HUANXIN_API_TOKEN 或自定义强密码
HUANXIN_OPEN_REGISTRATION=0        # 0=关闭公开注册，仅管理员账号

# ── 接真实大模型（全部从 .env 透传，勿硬编码 Key）──
# OpenAI 兼容
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# NVIDIA NIM：填 NVIDIA_API_KEY 并把 OPENAI_FALLBACK_PROVIDERS 设为 nvidia
NVIDIA_API_KEY=
OPENAI_FALLBACK_PROVIDERS=
OPENAI_FALLBACK_BASE_URLS=
